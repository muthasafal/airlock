{
  "enabled": true,
  "name": "Test on save",
  "description": "When a package TypeScript file is saved, run the tests related to the changed files.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "packages/**/*.ts"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "npx vitest run --changed",
    "timeout": 180
  }
}
