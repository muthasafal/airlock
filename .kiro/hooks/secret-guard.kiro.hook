{
  "enabled": true,
  "name": "Secret guard",
  "description": "Dogfooding: Airlock's own rule detectors check every prompt before it reaches the agent and block it (exit 2) if it contains an API key, JWT, private key, password, Aadhaar, PAN or card number. BRIEF \u00a712.",
  "version": "1",
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "runCommand",
    "command": "node packages/scrub-engine/bin/check-prompt.mjs",
    "timeout": 30
  }
}
