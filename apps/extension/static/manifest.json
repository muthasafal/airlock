{
  "manifest_version": 3,
  "name": "Airlock",
  "short_name": "Airlock",
  "version": "0.1.0",
  "description": "Paste into ChatGPT, Claude or Gemini without leaking secrets. Cleaned on your device first, restored only where you can see it.",
  "minimum_chrome_version": "138",
  "permissions": [
    "storage",
    "contextMenus",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Airlock",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
