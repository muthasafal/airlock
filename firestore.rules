rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: check if user is an org member
    function isMember(orgId) {
      return exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }
    
    // Helper: check if user is an org admin
    function isAdmin(orgId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Orgs
    match /orgs/{orgId} {
      allow read: if request.auth != null && isMember(orgId);
      allow create: if request.auth != null 
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null 
                    && isAdmin(orgId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['policy', 'protectedTerms']);
      
      // Members
      match /members/{uid} {
        allow read: if request.auth != null && isMember(orgId);
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null && isAdmin(orgId);
      }
      
      // Stats - counts only, no content
      match /stats/{date} {
        // Members can only increment numeric fields
        allow write: if request.auth != null 
                     && isMember(orgId)
                     && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['counts', 'requests', 'routes'])
                     && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['counts']) 
                         || request.resource.data.counts.keys().hasOnly([
                              'EMAIL', 'PHONE', 'AADHAAR', 'PAN', 'IFSC', 'BANK_ACCOUNT',
                              'CARD', 'UPI', 'API_KEY', 'JWT', 'PRIVATE_KEY', 'PASSWORD',
                              'IP_ADDRESS', 'URL_SECRET', 'ORG_TERM', 'PERSON', 'ORG',
                              'LOCATION', 'HEALTH', 'FINANCIAL_AMOUNT', 'LEGAL_MATTER',
                              'INTERNAL_PROJECT', 'CREDENTIAL', 'GOVERNMENT_ID', 'DATE_OF_BIRTH',
                              'OTHER_SENSITIVE'
                            ]))
                     && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['routes'])
                         || request.resource.data.routes.keys().hasOnly(['LOCAL_ANSWER', 'CLOUD_SCRUBBED', 'BLOCK']));
        
        allow read: if request.auth != null && isAdmin(orgId);
      }
    }
    
    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
