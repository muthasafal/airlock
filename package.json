{
  "name": "airlock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w packages/scrub-engine && npm run build -w packages/nano-detector && npm run build -w packages/cli && npm run build -w apps/extension && npm run build -w apps/web",
    "test": "vitest --passWithNoTests",
    "test:props": "npm run test:props -w packages/scrub-engine",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b && tsc --noEmit -p packages/cli && tsc --noEmit -p apps/extension",
    "lint": "eslint . --max-warnings 0",
    "preview": "npm run preview -w apps/web",
    "deploy": "npm run build && firebase deploy",
    "test:rules": "firebase emulators:exec --only firestore --project airlock-rules-test \"vitest run --config vitest.rules.config.ts\"",
    "test:integrations": "npm test -w packages/cli && cd apps/extension && npx playwright test"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "prettier": "^3.10.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.4"
  }
}
